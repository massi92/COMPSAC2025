{
  "openapi": "3.0.0",
  "info": {
    "title": "Model Comparison Service",
    "description": "A service that compares the outputs of two learning models using Pandas DataFrames containing the data.",
    "version": "1.0.0",
    "x-service-type": "MONITOR",
    "x-service-task-type": "COMPARISON"
  },
  "paths": {
    "/compare_models": {
      "post": {
        "summary": "Compare Model Outputs",
        "description": "Compares the outputs of two learning models using the provided datasets.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model1_output": {
                    "type": "object",
                    "description": "Output of the first learning model, represented as a JSON object mapping column names to arrays of values.",
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "model2_output": {
                    "type": "object",
                    "description": "Output of the second learning model, represented as a JSON object mapping column names to arrays of values.",
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                },
                "required": ["model1_output", "model2_output"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Comparison results between model outputs.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "correlation": {
                      "type": "number",
                      "format": "float",
                      "description": "Correlation coefficient between the outputs of the two models."
                    },
                    "rmse": {
                      "type": "number",
                      "format": "float",
                      "description": "Root Mean Squared Error between the outputs of the two models."
                    }
                  },
                  "required": ["correlation", "rmse"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input data."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  }
}
