{
  "openapi": "3.0.0",
  "info": {
    "title": "Pandas DataFrame Aggregation Service",
    "description": "A service that applies aggregation functions (e.g., min, max, avg) to specified attributes of a Pandas DataFrame.",
    "version": "1.0.0",
    "x-service-type": "DISPATCH"
  },
  "paths": {
    "/aggregate": {
      "post": {
        "summary": "Apply aggregation functions to specified attributes in a Pandas DataFrame.",
        "operationId": "aggregateDataFrame",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AggregateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation. Aggregated results are returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AggregateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid input data or unsupported aggregation function."
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AggregateRequest": {
        "type": "object",
        "properties": {
          "dataframe": {
            "$ref": "#/components/schemas/DataFrame"
          },
          "aggregations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "attribute": {
                  "type": "string",
                  "description": "The column to aggregate."
                },
                "function": {
                  "type": "string",
                  "enum": ["min", "max", "avg", "sum", "count"],
                  "description": "The aggregation function to apply."
                }
              },
              "required": ["attribute", "function"]
            },
            "description": "List of aggregation operations to apply."
          }
        },
        "required": [
          "dataframe",
          "aggregations"
        ]
      },
      "AggregateResponse": {
        "type": "object",
        "description": "Result of the aggregation functions.",
        "additionalProperties": {
          "type": ["number", "integer"]
        }
      },
      "DataFrame": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        },
        "description": "Pandas DataFrame represented as an array of row objects."
      }
    }
  }
}
