{
  "openapi": "3.0.0",
  "info": {
    "title": "Hierarchical Clustering Feature Selection Service",
    "description": "A service that applies the Hierarchical Clustering feature selection algorithm to a Pandas DataFrame.",
    "version": "1.0.0",
    "x-service-type": "DISPATCH"
  },
  "paths": {
    "/apply_hierarchical_clustering": {
      "post": {
        "summary": "Apply Hierarchical Clustering Feature Selection",
        "description": "Applies the Hierarchical Clustering feature selection algorithm to the input Pandas DataFrame and returns a DataFrame with selected features.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "dataframe": {
                    "type": "object",
                    "description": "Input data in a format compatible with a Pandas DataFrame (e.g., dictionary of column names to lists of values)"
                  },
                  "threshold": {
                    "type": "number",
                    "description": "Distance threshold to determine feature clusters"
                  }
                },
                "required": [
                  "dataframe",
                  "threshold"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Feature selection completed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "selected_dataframe": {
                      "type": "object",
                      "description": "Subset of the original DataFrame with selected features"
                    }
                  },
                  "required": [
                    "selected_dataframe"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input data or parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message detailing the issue with input"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
